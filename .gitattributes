# The shell scripts run on Linux -- in a container, on a build agent, on the cluster.
# Checked out on Windows without this they get CRLF, and the shebang line then ends
# in a carriage return: the kernel goes looking for an interpreter whose name has a
# stray control character on the end, and reports "No such file or directory". That
# reads as a missing interpreter rather than as a line ending, which is why
# memory-matrix.sh had never once run from a Windows checkout.
*.sh text eol=lf
Containerfile text eol=lf

# Same reasoning for anything else read by a Linux tool rather than by an editor.
*.yaml text eol=lf
*.yml text eol=lf
